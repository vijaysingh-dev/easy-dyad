[Unit]
Description=EEZI app startup (runs as user eezi)
After=network-online.target docker.service

[Service]
Type=oneshot
User=eezi
WorkingDirectory=/var/www/eezi
Environment=PATH=/home/eezi/.npm-global/bin:/usr/bin:/bin
ExecStart=/var/www/eezi/deploy/eezi-startup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
