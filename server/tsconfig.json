{
  "extends": "../tsconfig.json",

  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
}
